# Trên Render, set các biến này trong dashboard, KHÔNG commit file .env thật

# Lấy từ Supabase: Project Settings → Database → Connection string (Transaction)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Chuỗi bí mật bất kỳ, dùng để ký JWT
JWT_SECRET=change-me-to-a-long-random-string

# Domain frontend đang host (GitHub Pages) - dùng cho CORS
FRONTEND_URL=https://YOUR-USER.github.io

PORT=4000
NODE_ENV=production

# === Resend (Email) Configuration ===
# Đăng ký tại https://resend.com để lấy API key
# Free tier: 100 emails/ngày
RESEND_API_KEY=re_YOUR_API_KEY
# Email người gửi (cần verify domain trên Resend)
EMAIL_FROM=noreply@tracnghiemyh.cloud

# === Google OAuth Configuration ===
# Lấy từ Google Cloud Console: APIs & Services → Credentials → Tạo OAuth 2.0 Client ID
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# === PayOS Configuration ===
# Đăng ký tại https://payos.vn để lấy thông tin
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
