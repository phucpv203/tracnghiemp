# Mẫu biến môi trường cho backend
# Trên Render, set các biến này trong dashboard, KHÔNG commit file .env thật

# Lấy từ Supabase: Project Settings → Database → Connection string (Transaction)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Chuỗi bí mật bất kỳ, dùng để ký JWT
JWT_SECRET=change-me-to-a-long-random-string

# Domain frontend đang host (GitHub Pages) - dùng cho CORS
FRONTEND_URL=https://YOUR-USER.github.io

PORT=4000
NODE_ENV=production
